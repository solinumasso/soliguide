# dev / preprod / prod / CI / test
# ENV=dev
# PORT=3001
# The API derives the country of a request from its Origin header, so these must
# hold the canonical origin the web-app sends for each country: the FIRST entry
# of the matching PUBLIC_*_HOSTNAMES variable of the web-app.
# Only the hostname is compared, the scheme and the port are ignored, so every
# country needs a DISTINCT hostname. A bare `localhost` would collide with the
# Angular frontends below and be resolved as the first matching theme.
# WEBAPP_FR_URL=https://fr.localhost
# WEBAPP_ES_URL=https://es.localhost
# WEBAPP_AD_URL=https://ad.localhost
# WIDGET_URL=http://localhost:4201
# FRONTEND_URL=http://localhost:4200
# API_URL=http://localhost:3001
# SOLIGUIDE_LOCATION_API_URL=http://localhost:3000
# SOLIGUIA_ES_URL=dev_local.soliguia.es
# SOLIGUIA_AD_URL=dev_local.soliguia.ad
# SOLIGUIDE_FR_URL=dev_local.soliguide.fr

# JWT key secret
JWT_SECRET=XXXXXX

# Enable or not CRON jobs
# CRON_ENABLED=true

# Database value
# MONGODB_URI="mongodb://127.0.0.1:27017/soliguide?replicaSet=rs0"

# Google
# GOOGLE_PROJECT_ID=my-project
# GOOGLE_API_KEY=XXXXXX
# GOOGLE_MAPS_API_KEY=XXXXXX

# Emails
# DEFAULT_SENDER_EMAIL=xxxx@xxxx.org    # Default sender email address (only used in the contact form)

# S3
#S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
#S3_DOCUMENTS_BUCKET_NAME=documents
#S3_PICTURES_BUCKET_NAME=pictures

# Sentry
# SENTRY_DSN=

# Posthog
# SOLIGUIDE_POSTHOG_API_KEY=XXXXXX

# Database anonymization
DEV_ANON=true
# Password for all users when anonymizing
DEV_ANON_PASSWORD_FOR_ALL=SuperSolinum01!


# RabbitMQ connection URL
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/

# Brevo (CRM). Required for scripts/migrations pushing contacts to Brevo.
# BREVO_API_KEY=XXXXXX

NX_REJECT_UNKNOWN_LOCAL_CACHE=0
