# backend
API_URL="http://localhost:3001"

# frontend vars
PUBLIC_API_URL="http://localhost:3001"
PUBLIC_LOCATION_API_URL="http://localhost:3000"
# PUBLIC_SOLIGUIDE_POSTHOG_API_KEY="XXX"
# PUBLIC_SOLIGUIDE_POSTHOG_URL="XXX"

# theme
# Comma-separated list of hostnames served by each theme. The scheme, the port
# and a `www.` prefix are ignored, so `localhost` also matches `localhost:5173`.
# A theme with no hostname configured is simply never resolved.
#
# `*.localhost` resolves to 127.0.0.1 out of the box, so a single dev server
# serves every country and no /etc/hosts entry is needed:
#   http://localhost:5173     -> Soliguide France
#   http://es.localhost:5173  -> Soliguia Spain
#   http://ad.localhost:5173  -> Soliguia Andorra
#
# The FIRST hostname of a list is the origin sent to the API, which resolves the
# country by hostname alone, ports ignored. Each country therefore needs a
# distinct one, hence `fr.localhost` first for France: a bare `localhost` would
# collide with the Angular frontends and be resolved as Andorra. Keep these in
# sync with WEBAPP_FR_URL / WEBAPP_ES_URL / WEBAPP_AD_URL in packages/api/.env.
PUBLIC_SOLIGUIDE_FR_HOSTNAMES=fr.localhost,localhost
PUBLIC_SOLIGUIA_ES_HOSTNAMES=es.localhost
PUBLIC_SOLIGUIA_AD_HOSTNAMES=ad.localhost

ENV=development
PUBLIC_CHAT_WEBSITE_ID=

#Sentry
PUBLIC_SENTRY_DSN=
PRIVATE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
